# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# FIREBASE_API_KEY: Dynamic loading key for secure Firebase Authentication initialization
FIREBASE_API_KEY=AIzaSyFakeApiKeyForInitializationOnlyAndPrototype

# FIREBASE_APP_ID: Dynamic application client identifier for Firebase services
FIREBASE_APP_ID=1:1234567890:android:abc123xyz

# FIREBASE_PROJECT_ID: Target cloud Firebase Project ID
FIREBASE_PROJECT_ID=personal-os-secure-sync

# GOOGLE_CLIENT_ID: Client ID for authenticating Google Sign-In transactions
GOOGLE_CLIENT_ID=your-google-web-client-id-here.apps.googleusercontent.com

